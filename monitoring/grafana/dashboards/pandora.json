{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "Active Sandboxes",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 3 },
              { "color": "red", "value": 4 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "pandora_active_vms", "legendFormat": "active", "refId": "A" }
      ]
    },
    {
      "title": "Warm VMs",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "green", "value": 3 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "pandora_warm_vms", "legendFormat": "warm", "refId": "A" }
      ]
    },
    {
      "title": "Total Executions",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [{ "color": "blue", "value": null }]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(pandora_executions_total)", "legendFormat": "total", "refId": "A" }
      ]
    },
    {
      "title": "Sandboxes Created",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [{ "color": "purple", "value": null }]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "pandora_sandboxes_created_total", "legendFormat": "created", "refId": "A" }
      ]
    },
    {
      "title": "Reaped / Failed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "targets": [
        { "expr": "pandora_sandboxes_reaped_total", "legendFormat": "reaped", "refId": "A" },
        { "expr": "pandora_warm_boot_failures_total", "legendFormat": "boot failures", "refId": "B" }
      ]
    },
    {
      "title": "Execution Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 20, "lineWidth": 2 },
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "sum(rate(pandora_executions_total[1m]))", "legendFormat": "execs/sec", "refId": "A" },
        { "expr": "rate(pandora_sandboxes_created_total[1m])", "legendFormat": "sandboxes/sec", "refId": "B" }
      ]
    },
    {
      "title": "Active vs Warm VMs",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 30, "lineWidth": 2, "stacking": { "mode": "normal" } },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "active" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warm" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        { "expr": "pandora_active_vms", "legendFormat": "active", "refId": "A" },
        { "expr": "pandora_warm_vms", "legendFormat": "warm", "refId": "B" }
      ]
    },
    {
      "title": "Sandbox Acquire Latency (p50 / p90 / p99)",
      "description": "How long clients wait to get a sandbox from the warm pool",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(pandora_sandbox_acquire_seconds_bucket[2m]))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.90, rate(pandora_sandbox_acquire_seconds_bucket[2m]))", "legendFormat": "p90", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(pandora_sandbox_acquire_seconds_bucket[2m]))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "title": "Exec Latency (p50 / p90 / p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(pandora_vm_exec_seconds_bucket[2m]))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.90, rate(pandora_vm_exec_seconds_bucket[2m]))", "legendFormat": "p90", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(pandora_vm_exec_seconds_bucket[2m]))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "title": "VM Boot Latency (p50 / p90 / p99)",
      "description": "Background warm boot time — not seen by clients",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(pandora_vm_boot_seconds_bucket[2m]))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.90, rate(pandora_vm_boot_seconds_bucket[2m]))", "legendFormat": "p90", "refId": "B" },
        { "expr": "histogram_quantile(0.99, rate(pandora_vm_boot_seconds_bucket[2m]))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "title": "Sandbox Lifetime",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(pandora_sandbox_lifetime_seconds_bucket[2m]))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.90, rate(pandora_sandbox_lifetime_seconds_bucket[2m]))", "legendFormat": "p90", "refId": "B" }
      ]
    },
    {
      "title": "Execution Outcomes",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 30, "lineWidth": 2, "stacking": { "mode": "normal" } },
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "success" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "timeout" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          }
        ]
      },
      "targets": [
        { "expr": "rate(pandora_executions_total{status=\"success\"}[1m])", "legendFormat": "success", "refId": "A" },
        { "expr": "rate(pandora_executions_total{status=\"error\"}[1m])", "legendFormat": "error", "refId": "B" },
        { "expr": "rate(pandora_executions_total{status=\"timeout\"}[1m])", "legendFormat": "timeout", "refId": "C" }
      ]
    },
    {
      "title": "Teardown Latency (p50 / p90)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "custom": { "fillOpacity": 10, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        { "expr": "histogram_quantile(0.50, rate(pandora_vm_teardown_seconds_bucket[2m]))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.90, rate(pandora_vm_teardown_seconds_bucket[2m]))", "legendFormat": "p90", "refId": "B" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["pandora", "firecracker", "observability"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Pandora – Ephemeral Interpreter",
  "uid": "pandora-main",
  "version": 1
}
